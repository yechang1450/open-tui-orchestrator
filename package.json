{
  "name": "open-tui-orchestrator",
  "version": "26.10.18-1",
  "private": false,
  "description": "Split a multi-part agent request into a verified TODO ledger, then run the parallel blocks in hidden or visible TUI windows of the agent CLI you already use (Windows).",
  "type": "module",
  "bin": {
    "open-tui-orchestrator": "cli.mjs",
    "orch": "orch.mjs",
    "orch-adapt": "scripts/adapt.mjs"
  },
  "scripts": {
    "pretest": "node scripts/test-platform-guard.mjs",
    "test": "node --test --test-concurrency=3 test/*.test.mjs",
    "test:portable": "node --test test/window-entry.test.mjs",
    "doctor": "node cli.mjs --agent codex --doctor",
    "setup": "npm ci --prefix scripts"
  },
  "files": [
    "cli.mjs",
    "orch.mjs",
    "package.json",
    "release.json",
    "README.md",
    "README-zh.md",
    "INSTALL.md",
    "INSTALL-zh.md",
    "LICENSE",
    "scripts",
    "!scripts/node_modules",
    "!scripts/gate.mjs",
    "!scripts/host-cli.mjs",
    "!scripts/network-policy.mjs",
    "!scripts/agent.mjs",
    "!scripts/agent-auth-prompt.txt",
    "!scripts/test-platform-guard.mjs",
    "!scripts/open-tui-orchestrator-force.mjs",
    "!scripts/open-tui-orchestrator-preflight.mjs",
    "!scripts/todo-list.mjs"
  ],
  "keywords": [
    "agent",
    "orchestrator",
    "parallel",
    "multi-agent",
    "tui",
    "cli",
    "windows",
    "codex",
    "claude",
    "openclaw",
    "automation"
  ],
  "author": "Yang Wenchàng (yechang1450)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yechang1450/open-tui-orchestrator.git"
  },
  "homepage": "https://github.com/yechang1450/open-tui-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/yechang1450/open-tui-orchestrator/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
